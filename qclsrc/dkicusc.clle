/* ----------------------------------------------------------------- */
             PGM

             ADDLIBLE   LIB(AMNA1)
             MONMSG     MSGID(CPF2103) /* sudah ada di *LIBL */

             CALL       PGM(AMNA1/DKICUSR)

             ENDPGM
